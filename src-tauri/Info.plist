<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>NSCameraUsageDescription</key>
    <string>roll records your camera as one source of a capture pack.</string>
    <key>NSMicrophoneUsageDescription</key>
    <string>roll records your microphone as one source of a capture pack.</string>
    <!-- opt in to the modern Continuity Camera device type; without it WebKit's
         getUserMedia falls back to the deprecated .external path and the iPhone
         camera preview comes through black -->
    <key>NSCameraUseContinuityCameraDeviceType</key>
    <true/>
</dict>
</plist>
