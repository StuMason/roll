{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Roll",
  "version": "0.0.1",
  "identifier": "dev.stumason.roll",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Roll",
        "width": 360,
        "height": 520,
        "resizable": true,
        "minWidth": 320,
        "minHeight": 420
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Record once. Hand the agent a queryable pack.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
